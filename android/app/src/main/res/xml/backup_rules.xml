<?xml version="1.0" encoding="utf-8"?>
<!--
  Credentials and private reading data are excluded.

  The Keystore-backed prefs are excluded because a Keystore key does not travel with
  the backup: restoring an encrypted blob whose key is missing yields garbage, and the
  tokens inside are useless on the new device anyway — the user signs in again.

  The *_fallback files are excluded because they are PLAINTEXT. They only come into
  use when a device's Keystore is unavailable, and on such a device they hold the AI
  API key and the session tokens in the clear, which would otherwise be uploaded into
  the user's Google backup / device-transfer bundle.

  The vocab and stats files live in filesDir, not sharedpref, and were therefore
  never covered by the sharedpref rules above. They hold the user's saved words,
  their definitions, and the reading history those come from — everything the export
  feature treats as worth moving to a new tablet. That is the user's own data rather
  than a credential, so it is excluded for the same reason the rest is: it should
  travel deliberately, through DataArchive, and not silently ride along in a cloud
  backup bundle that also leaves the device's owner in control of it.

  books/ and imports/ hold copies of the user's own files, so they are left in: they
  are large, already stored in the user's Google account via the sync server, and
  silently dropping them would make a restored library look broken.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="bookcon_secure_prefs.xml" />
    <exclude domain="sharedpref" path="bookcon_ai_fallback.xml" />
    <exclude domain="sharedpref" path="bookcon_ai_secure.xml" />
    <exclude domain="sharedpref" path="bookcon_session_fallback.xml" />
    <exclude domain="file" path="vocab" />
    <exclude domain="file" path="stats" />
</full-backup-content>
