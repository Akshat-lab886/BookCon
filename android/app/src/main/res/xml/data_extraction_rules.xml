<?xml version="1.0" encoding="utf-8"?>
<!--
  See backup_rules.xml for why. The short version: the Keystore-backed files cannot be
  restored usefully, and the *_fallback files are PLAINTEXT — excluding them is what
  stops the AI key and session tokens leaving the device in a cloud backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="bookcon_secure_prefs.xml" />
        <exclude domain="sharedpref" path="bookcon_ai_fallback.xml" />
        <exclude domain="sharedpref" path="bookcon_ai_secure.xml" />
        <exclude domain="sharedpref" path="bookcon_session_fallback.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bookcon_secure_prefs.xml" />
        <exclude domain="sharedpref" path="bookcon_ai_fallback.xml" />
        <exclude domain="sharedpref" path="bookcon_ai_secure.xml" />
        <exclude domain="sharedpref" path="bookcon_session_fallback.xml" />
    </device-transfer>
</data-extraction-rules>
