<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat descendant is REQUIRED: MainActivity extends AppCompatActivity,
         and launching it under a plain framework theme crashes on setContentView. -->
    <style name="Theme.BookCon" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
